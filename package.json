{
  "name": "agent-mcp",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun run build && bun --watch src/index.ts",
    "build": "vite build",
    "build:binary": "bun run build && bun scripts/build-binary.ts",
    "package:npm": "bun run build:binary && bun scripts/package-npm.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"web/src/**/*.{ts,tsx}\"",
    "start": "bun run build && bun src/index.ts",
    "start:prod": "bun --no-env-file run build && bun --no-env-file --env-file=.env.production src/index.ts",
    "test": "bun test",
    "schema:tokens": "bun scripts/schema-tokens.ts",
    "operator:reset-password": "bun scripts/reset-password.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "4.13.13",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "geist": "1.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "patchedDependencies": {
    "better-auth@1.7.7": "patches/better-auth@1.7.7.patch",
    "@better-auth/cimd@1.7.7": "patches/@better-auth%2Fcimd@1.7.7.patch",
    "@better-auth/oauth-provider@1.7.7": "patches/@better-auth%2Foauth-provider@1.7.7.patch"
  }
}
